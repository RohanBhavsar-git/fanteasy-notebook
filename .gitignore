# Data
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# data/output/ holds the Phase 7 export -- the actual dashboard deliverable,
# not intermediate cache, so it's committed while raw/processed stay excluded.
data/output/*
!data/output/.gitkeep
!data/output/player_advanced_stats.json

# models/ holds the Phase 8 model artifact (src/artifacts.py) -- committed
# by retrain.yml only, same "deliverable, not cache" exception as
# data/output/ above. weekly-update.yml reads it but never writes it.
models/*
!models/.gitkeep
!models/fanteasy_model.joblib

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# MLflow (later phases)
mlruns/
mlartifacts/

# Environment variables
.env
